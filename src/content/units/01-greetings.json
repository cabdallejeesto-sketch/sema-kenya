    { "id": "g.naitwa", "sw": "Naitwa Amina", "en": "My name is Amina (lit. I'm called Amina)", "so": "Waxaa la i yiraahdaa Amina", "v": "standard", "alt": ["ninaitwa amina", "jina langu ni amina"] },
    { "id": "g.jina-langu", "sw": "Jina langu ni Abdi", "en": "My name is Abdi", "so": "Magacaygu waa Abdi", "v": "standard", "alt": ["naitwa abdi"] },
    { "id": "g.natoka", "sw": "Natoka Hargeisa", "en": "I come from Hargeisa", "so": "Waxaan ka imid Hargeisa", "v": "standard", "alt": ["ninatoka hargeisa"] },
