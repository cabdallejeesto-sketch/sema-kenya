{
  "id": "greetings",
  "order": 1,
  "level": "A1",
  "color": "#15803d",
  "reviewed": false,
  "title": { "en": "Greetings & Respect", "so": "Salaanta iyo Ixtiraamka" },
  "swTitle": "Salamu na Heshima",
  "description": {
    "en": "Say hello the Kenyan way, answer greetings, show respect to elders and introduce yourself.",
    "so": "Salaan sida Kenyaanka, ka jawaab salaanta, ixtiraam waayeelka, oo is baro."
  },
  "guide": [
    {
      "title": { "en": "Greet first, then talk", "so": "Marka hore salaan, kadib hadal" },
      "body": {
        "en": "In Kenya you greet before you ask anything, even in a shop or a matatu. A quick Sasa? or Habari? opens every conversation. The reply is almost always positive.",
        "so": "Kenya waxaad salaantaa ka hor intaadan wax weydiin, xataa dukaan ama matatu dhexdeed. Sasa? ama Habari? degdeg ah ayaa fura sheeko kasta. Jawaabtu had iyo jeer waa mid wanaagsan."
      },
      "examples": [
        { "sw": "Habari? – Nzuri.", "en": "How are you? – Fine.", "so": "Iska warran? – Waan fiicanahay.", "v": "standard" },
        { "sw": "Sasa? – Poa.", "en": "Hi, what's up? – Cool.", "so": "Haye, maxaa jira? – Fiican.", "v": "everyday" }
      ]
    },
    {
      "title": { "en": "Casual Kenya: Sasa? Poa!", "so": "Kenya fudud: Sasa? Poa!" },
      "body": {
        "en": "Friends and young people say Sasa?, Mambo? or Uko aje? The usual answers are Poa, Fiti or Niko poa. These are everyday Kenyan forms, used far more than the textbook Hujambo?",
        "so": "Saaxiibbada iyo dhallinyaradu waxay yiraahdaan Sasa?, Mambo? ama Uko aje? Jawaabaha caadiga ahi waa Poa, Fiti ama Niko poa. Kuwani waa qaabab Kenya oo maalinle ah, waxaana loo isticmaalaa wax ka badan Hujambo? ee buugaagta."
      },
      "examples": [
        { "sw": "Uko aje?", "en": "How are you? (casual)", "so": "Sidee tahay? (fudud)", "v": "everyday" },
        { "sw": "Niko fiti.", "en": "I'm good.", "so": "Waan fiicanahay.", "v": "everyday" }
      ]
    },
    {
      "title": { "en": "Respect for elders", "so": "Ixtiraamka waayeelka" },
      "body": {
        "en": "Add mzee for an older man and mama for an older woman: Habari yako, mzee? On the coast and in Tanzania young people greet elders with Shikamoo, and the elder answers Marahaba. Inland Kenyans use it much less.",
        "so": "Ku dar mzee nin ka weyn iyo mama naag ka weyn: Habari yako, mzee? Xeebta iyo Tanzania dhallinyaradu waxay waayeelka ku salaamaan Shikamoo, waayeelkuna wuxuu ku jawaabaa Marahaba. Kenyaanka gudaha aad uma isticmaalaan."
      },
      "examples": [
        { "sw": "Habari yako, mzee?", "en": "How are you, sir?", "so": "Sidee tahay, adeer?", "v": "standard" },
        { "sw": "Shikamoo! – Marahaba.", "en": "Respectful greeting to an elder – the elder's reply", "so": "Salaan ixtiraam ah oo waayeelka – jawaabta waayeelka", "v": "coastal" }
      ]
    },
    {
      "title": { "en": "Requests are direct, and that's polite", "so": "Codsigu waa toos, taasina waa edeb" },
      "body": {
        "en": "Kenyans ask directly: Nipe chai (Give me tea) is normal and friendly. Tafadhali (please) is used less than 'please' in English. A warm tone and a greeting first matter more.",
        "so": "Kenyaanku si toos ah ayay wax u weydiistaan: Nipe chai (Shaah i sii) waa caadi oo waa saaxiibtinimo. Tafadhali (fadlan) looma isticmaalo sida 'please' ee Ingiriisiga. Cod diirran iyo salaan hore ayaa ka muhiimsan."
      }
    }
  ],
  "items": [
    { "id": "g.habari", "sw": "Habari?", "en": "How are you? (lit. What's the news?)", "so": "Iska warran? (macnaha: Maxaa war ah?)", "v": "standard", "syn": "hello", "note": { "en": "The answer is almost always positive: Nzuri.", "so": "Jawaabtu had iyo jeer waa mid wanaagsan: Nzuri." } },
    { "id": "g.nzuri", "sw": "Nzuri", "en": "Fine / good", "so": "Wanaagsan / waan fiicanahay", "v": "standard", "syn": "fine" },
    { "id": "g.habari-yako", "sw": "Habari yako?", "en": "How are you? (to one person)", "so": "Sidee tahay? (hal qof)", "v": "standard", "syn": "hello" },
    { "id": "g.asante", "sw": "Asante", "en": "Thank you", "so": "Mahadsanid", "v": "standard", "syn": "thanks" },
    { "id": "g.asante-sana", "sw": "Asante sana", "en": "Thank you very much", "so": "Aad baad u mahadsantahay", "v": "standard", "syn": "thanks" },
    { "id": "g.karibu", "sw": "Karibu", "en": "Welcome / You're welcome", "so": "Soo dhawoow / Adaa mudan", "v": "standard", "note": { "en": "Kenyans say it when you thank them, and when they invite you in.", "so": "Kenyaanku waxay yiraahdaan markaad u mahadnaqdo, iyo markay ku martiqaadaan." } },

    { "id": "g.sasa", "sw": "Sasa?", "en": "Hi! What's up?", "so": "Haye! Maxaa jira?", "v": "everyday", "syn": "hello", "note": { "en": "The most common casual greeting in Kenya. Answer: Poa or Fiti.", "so": "Salaanta fudud ee ugu badan Kenya. Jawaab: Poa ama Fiti." } },
    { "id": "g.poa", "sw": "Poa", "en": "Cool / I'm fine", "so": "Fiican / waan fiicanahay", "v": "everyday", "syn": "fine" },
    { "id": "g.mambo", "sw": "Mambo?", "en": "How's it going?", "so": "Sidee wax yihiin?", "v": "everyday", "syn": "hello", "note": { "en": "Answer: Poa.", "so": "Jawaab: Poa." } },
    { "id": "g.uko-aje", "sw": "Uko aje?", "en": "How are you? (casual)", "so": "Sidee tahay? (si fudud)", "v": "everyday", "syn": "hello", "tz": "Uko vipi?", "note": { "en": "A Kenyan casual form that started in Sheng. Most young Kenyans use it.", "so": "Qaab Kenya oo fudud oo ka bilowday Sheng. Dhallinyarada Kenya badankoodu way isticmaalaan." } },
    { "id": "g.niko-poa", "sw": "Niko poa", "en": "I'm fine", "so": "Waan fiicanahay", "v": "everyday", "syn": "fine", "alt": ["niko fiti", "niko sawa"] },
    { "id": "g.niko-fiti", "sw": "Niko fiti", "en": "I'm good (lit. I'm fit)", "so": "Waan wanaagsanahay", "v": "everyday", "syn": "fine", "alt": ["niko poa", "niko sawa"] },

    { "id": "g.mzee", "sw": "mzee", "en": "sir / respected older man", "so": "adeer / nin weyn oo la ixtiraamo", "v": "standard", "note": { "en": "Use it to greet an older man politely: Habari yako, mzee? In Kenya mzee wangu can also mean 'my dad'.", "so": "U isticmaal markaad si edeb leh u salaamayso nin kaa weyn: Habari yako, mzee? Kenya, mzee wangu waxay sidoo kale noqon kartaa 'aabahay'." } },
    { "id": "g.mama", "sw": "mama", "en": "madam / respected woman", "so": "marwo / naag la ixtiraamo", "v": "everyday", "note": { "en": "Kenyans politely call an older woman mama, even a stranger at the market.", "so": "Kenyaanku si edeb leh ayay naag ka weyn ugu yeeraan mama, xataa qof aan la aqoon oo suuqa jooga." } },
    { "id": "g.tafadhali", "sw": "Tafadhali", "en": "Please", "so": "Fadlan", "v": "standard" },
    { "id": "g.samahani", "sw": "Samahani", "en": "Excuse me / Sorry (apology)", "so": "Iga raalli ahaw / Raalli noqo", "v": "standard" },
    { "id": "g.pole", "sw": "Pole", "en": "Sorry (sympathy)", "so": "Ka xumahay (marka qof dhib ku dhaco)", "v": "standard", "note": { "en": "Say it when something bad happens to someone, even something small. The reply is Asante.", "so": "Dheh marka qof wax xun ku dhacaan, xataa wax yar. Jawaabtu waa Asante." } },
    { "id": "g.habari-asubuhi", "sw": "Habari ya asubuhi?", "en": "Good morning (lit. news of the morning?)", "so": "Subax wanaagsan", "v": "everyday", "tz": "Habari za asubuhi?", "alt": ["habari za asubuhi"] },

